# Configuración opcional para desarrollo local de SOM.
# En blanco: los datos se guardan en %APPDATA%\SOM\data.
SOM_DATA_DIR=
# En blanco: los respaldos se guardan dentro de SOM_DATA_DIR\backups.
SOM_BACKUP_DIR=
# Opcional: ejecutable Python para desarrollo. Por defecto usa backend\.venv\Scripts\python.exe.
SOM_PYTHON=
# No agregues contraseñas, tokens ni credenciales. El token API se genera al iniciar Electron.
